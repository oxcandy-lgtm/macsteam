{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local runtime acceptance receipt",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "target",
    "status",
    "evidence",
    "security"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "macsteam_local_runtime_acceptance" },
    "target": {
      "type": "object",
      "required": ["recipe_id", "steam_app_id"],
      "properties": {
        "recipe_id": { "type": "string", "const": "cloverpit" },
        "steam_app_id": { "type": "string", "const": "3314790" }
      }
    },
    "status": {
      "type": "object",
      "required": ["state", "blocker"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["blocked", "in_progress", "accepted", "invalidated"]
        },
        "blocker": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "imported_wine_selected",
        "runtime_real_load_healthy",
        "canonical_prefix_bound",
        "steam_install_verified",
        "cloverpit_install_ready",
        "supervised_game_session_started",
        "ownership_census_proven",
        "target_window_visible",
        "visibility_stable_seconds",
        "main_menu_confirmed_by_operator",
        "input_response_confirmed_by_operator",
        "cleanup_complete"
      ]
    },
    "security": {
      "type": "object",
      "required": [
        "credentials_accessed",
        "raw_pid_emitted",
        "raw_path_emitted",
        "raw_session_id_emitted",
        "raw_window_identity_emitted"
      ]
    }
  }
}